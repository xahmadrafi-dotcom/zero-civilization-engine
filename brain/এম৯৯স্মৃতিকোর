        পাঠ্য += f"## 🎶 সর্বশেষ সংকেত: {তথ্য['সর্বশেষ_সংকেত']['শিরোনাম']}\n"
        পাঠ্য += f"```text\n{তথ্য['সর্বশেষ_সংকেত']['গীতপাঠ']}\n```\n\n"

